# Copy to .env and fill locally. Never commit the populated .env file.
# These exact lowercase names are read by scripts/paf_client.py.
agent_factory_url=https://YOUR_PAF_HOST:8080/agentFactory/
agent_factory_username=YOUR_PAF_USERNAME
agent_factory_password=REPLACE_LOCALLY

# Full setup guide: docs/setup/README.md
# Database connections/wallets, provider credentials and PAF resources are
# configured separately. Extra keys here do not override helper constants.
